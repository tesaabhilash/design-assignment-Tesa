module fifo(
    input clk,
    input rst,
    input wren,
    input rden,
    input [7:0] datain,
    output full,
    output empty,
    output reg [7:0] dataout
);

reg [7:0] mem[7:0];
reg [2:0] wr_ptr;
reg [2:0] rd_ptr;

integer i;

assign full  = ((wr_ptr + 3'b001) == rd_ptr) ? 1'b1 : 1'b0;
assign empty = (wr_ptr == rd_ptr) ? 1'b1 : 1'b0;

always @(posedge clk) begin

    if(rst) begin
    wr_ptr <= 0;
    rd_ptr <= 0;
    dataout <= 0;

    for(i=0;i<8;i=i+1)
        mem[i] <= 0;
end

    else if(wren && !full) begin
      

        mem[wr_ptr] <= datain;
        wr_ptr <= wr_ptr + 3'b001;
    end

    else if(rden && !empty) begin
       

        dataout <= mem[rd_ptr];
        rd_ptr <= rd_ptr + 3'b001;
    end

end

endmodule
